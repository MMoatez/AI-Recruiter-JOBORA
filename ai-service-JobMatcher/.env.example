# Copy to .env for local development. Never commit real values.
# The application also reads process environment variables.

# Internal service (NestJS calls these endpoints with this shared secret).
# If empty, TRAINING_AI_INTERNAL_TOKEN is used so the existing local secret can be reused.
JOB_MATCHER_INTERNAL_TOKEN=lematchingseradetaillé12344

# Service binding
JOB_MATCHER_HOST=127.0.0.1
JOB_MATCHER_PORT=8010
JOB_MATCHER_ENV=development

# Groq (external AI provider, server-side only - never sent to the browser)
GROQ_API_KEY=
GROQ_MODEL_JOB_MATCHER=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# Matching pipeline
JOB_MATCHER_EXPLAIN_TOP_N=10
JOB_MATCHER_MAX_JOBS=200
JOB_MATCHER_EXPERIENCE_TOLERANCE=1
JOB_MATCHER_MAX_CV_CHARS=30000
JOB_MATCHER_MIN_CV_CHARS=20

# Deterministic scoring weights (defaults shown; renormalized at load time)
JOB_MATCHER_WEIGHT_REQUIRED_SKILLS=0.40
JOB_MATCHER_WEIGHT_PREFERRED_SKILLS=0.15
JOB_MATCHER_WEIGHT_EXPERIENCE=0.20
JOB_MATCHER_WEIGHT_SENIORITY=0.10
JOB_MATCHER_WEIGHT_SEMANTIC_FIT=0.15
