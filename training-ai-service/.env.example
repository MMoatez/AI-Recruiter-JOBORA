# Copy to .env for local development. The application also reads process
# environment variables. Never expose these values to Vite.
# AI_RECRUITER_DATABASE_PATH, CORS, and LOCAL_DEMO_ONLY are legacy-app settings;
# the JOBORA app.jobora_main entrypoint does not initialize SQLite or CORS.
AI_RECRUITER_ENV=development
AI_RECRUITER_DATABASE_PATH=./data/training.db
AI_RECRUITER_CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# Obtain the key from GroqCloud. Never put it in a VITE_* variable.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional override for the bundled CV-Embed SBERT artifact. If unset, the
# service uses models/cv_matching_sbert, then SENTENCE_TRANSFORMER_MODEL.
CV_MATCHING_MODEL_PATH=

AI_RECRUITER_LOCAL_DEMO_ONLY=true
AI_RECRUITER_USE_FINETUNED_EMBEDDINGS=false
AI_RECRUITER_FINETUNED_CHECKPOINT=./training_experiments/artifacts/model
TRAINING_AI_INTERNAL_TOKEN=replace-with-a-long-random-local-secret
CV_MATCHING_INTERNAL_TOKEN=replace-with-the-same-long-random-local-secret
