PORT=3000
SQLITE_PATH=data/jobora.sqlite
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_MS=1000
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
FRONTEND_URL=http://localhost:8443
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_SERVICE_TIMEOUT_MS=15000

RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8001
RAG_COLLECTION=jobora_ats_knowledge
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=480000
TRAINING_AI_SERVICE_URL=http://127.0.0.1:8002
TRAINING_AI_TIMEOUT_MS=120000
TRAINING_AI_INTERNAL_TOKEN=replace-with-a-long-local-secret
CV_MATCHING_INTERNAL_TOKEN=replace-with-the-same-long-local-secret-used-by-training-ai-service
CV_MATCHING_TIMEOUT_MS=120000
# Job Matcher AI service (FastAPI, port 8010). The token falls back to
# TRAINING_AI_INTERNAL_TOKEN when JOB_MATCHER_INTERNAL_TOKEN is not set.
JOB_MATCHER_AI_SERVICE_URL=http://127.0.0.1:8010
JOB_MATCHER_AI_TIMEOUT_MS=120000
JOB_MATCHER_INTERNAL_TOKEN=replace-with-the-same-long-local-secret-used-by-job-matcher-ai-service
