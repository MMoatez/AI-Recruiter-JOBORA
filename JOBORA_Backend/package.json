{
  "name": "jobora-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "eval:portfolio": "npm run evaluate:portfolio --",
    "evaluate:portfolio": "tsx --tsconfig tsconfig.json scripts/evaluate-portfolio.ts",
    "finetune:portfolio:dataset": "python finetuning/portfolio_extraction/generate_synthetic_dataset.py",
    "finetune:portfolio:audit": "python finetuning/portfolio_extraction/audit_dataset.py",
    "finetune:portfolio:prepare": "python finetuning/portfolio_extraction/prepare_dataset.py",
    "finetune:portfolio:train": "python finetuning/portfolio_extraction/train.py",
    "finetune:portfolio:merge": "python finetuning/portfolio_extraction/merge_adapter.py",
    "finetune:portfolio:evaluate": "python finetuning/portfolio_extraction/evaluate_ollama.py",
    "finetune:portfolio:smoke:cpu": ".venv-finetune-cpu\\Scripts\\python.exe finetuning/portfolio_extraction/train.py --allow-cpu --method lora --model finetuning/portfolio_extraction/base-models/smollm2-135m-instruct --max-length 512 --gradient-accumulation 2 --max-steps 2",
    "finetune:portfolio:train:cpu": ".venv-finetune-cpu\\Scripts\\python.exe finetuning/portfolio_extraction/train.py --allow-cpu --method lora --model finetuning/portfolio_extraction/base-models/smollm2-135m-instruct --max-length 512 --gradient-accumulation 2 --epochs 3",
    "finetune:portfolio:merge:cpu": ".venv-finetune-cpu\\Scripts\\python.exe finetuning/portfolio_extraction/merge_adapter.py --model finetuning/portfolio_extraction/base-models/smollm2-135m-instruct",
    "finetune:portfolio:evaluate:smoke": ".venv-finetune-cpu\\Scripts\\python.exe finetuning/portfolio_extraction/evaluate_ollama.py --model jobora-portfolio-extractor --limit 8",
    "rag:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File rag_service/setup.ps1",
    "rag:start": "powershell -NoProfile -ExecutionPolicy Bypass -File rag_service/start.ps1",
    "rag:index": "powershell -NoProfile -ExecutionPolicy Bypass -File rag_service/index.ps1",
    "rag:reindex": "powershell -NoProfile -ExecutionPolicy Bypass -File rag_service/index.ps1 -Force"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "mongodb": "~7.7",
    "mongoose": "^9.11.1",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
