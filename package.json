{
  "name": "jobora-cv-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "frontend:dev": "npm --prefix JOBORA_Frontend run dev",
    "backend:dev": "npm --prefix JOBORA_Backend run start:dev",
    "rag:setup": "npm --prefix JOBORA_Backend run rag:setup",
    "rag:start": "npm --prefix JOBORA_Backend run rag:start",
    "rag:index": "npm --prefix JOBORA_Backend run rag:index",
    "ai:dev": "cd ai-service-Skillora && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "training-ai:setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File training-ai-service/scripts/setup_windows.ps1",
    "training-ai:dev": "cd training-ai-service && .venv\\Scripts\\python.exe -m uvicorn app.jobora_main:app --host 127.0.0.1 --port 8002",
    "training-ai:test": "cd training-ai-service && .venv\\Scripts\\python.exe -m pytest -q",
    "training-ai:matching-test": "cd training-ai-service && .venv\\Scripts\\python.exe -m pytest tests/test_matching_analysis.py tests/test_internal_matching.py -q",
    "matching:setup": "npm run training-ai:setup:windows",
    "matching:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-matching.ps1",
    "job-matcher-ai:setup:windows": "cd ai-service-JobMatcher && python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "job-matcher-ai:dev": "cd ai-service-JobMatcher && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8010",
    "job-matcher-ai:test": "cd ai-service-JobMatcher && .venv\\Scripts\\python.exe -m pytest -q",
    "frontend:test": "npm --prefix JOBORA_Frontend test",
    "backend:test": "npm --prefix JOBORA_Backend test",
    "test": "npm run frontend:test && npm run backend:test",
    "frontend:build": "npm --prefix JOBORA_Frontend run build",
    "backend:build": "npm --prefix JOBORA_Backend run build",
    "build": "npm run frontend:build && npm run backend:build"
  }
}
